<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WF-C710N" android:textColor="#78909C" android:textSize="11sp" android:letterSpacing="0.08" />
            <TextView android:id="@+id/mode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="..." android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textColor="#6B7785" android:textSize="14sp" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_margin="2dp" android:orientation="vertical" android:gravity="center"
            android:paddingTop="7dp" android:paddingBottom="7dp" android:background="@drawable/chip_bg">
            <TextView android:id="@+id/bl" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="L" android:textColor="#78909C" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_margin="2dp" android:orientation="vertical" android:gravity="center"
            android:paddingTop="7dp" android:paddingBottom="7dp" android:background="@drawable/chip_bg">
            <TextView android:id="@+id/br" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="R" android:textColor="#78909C" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_margin="2dp" android:orientation="vertical" android:gravity="center"
            android:paddingTop="7dp" android:paddingBottom="7dp" android:background="@drawable/chip_bg">
            <TextView android:id="@+id/bc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/bat_case" android:textColor="#78909C" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="3dp" android:background="@drawable/seg_track">
        <TextView android:id="@+id/b_nc"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/w_nc" android:textColor="#B0BEC5"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
            android:background="@drawable/seg_none" />
        <TextView android:id="@+id/b_amb"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/w_amb" android:textColor="#B0BEC5"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
            android:background="@drawable/seg_none" />
        <TextView android:id="@+id/b_off"
            android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/seg_off" android:textColor="#B0BEC5"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
            android:background="@drawable/seg_none" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/label_level" android:textColor="#78909C" android:textSize="11sp" />
        <TextView android:id="@+id/lvl" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="#78909C" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/seg0" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg4" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg5" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg6" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg7" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg8" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
        <TextView android:id="@+id/seg9" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/seg_off" />
    </LinearLayout>
</LinearLayout>
